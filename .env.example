# Copy this file to .env. The .env file is ignored by Git.
# Never commit real API keys.

GOOSE_IMAGE=ghcr.io/aaif-goose/goose:v1.44.0
GOOSE_PROVIDER=openrouter
GOOSE_MODEL=
OPENROUTER_API_KEY=

# Relative paths are resolved from compose/. ".." mounts this repository.
# Use an absolute WSL path to work on another project directory.
AIW_GOOSE_WORKSPACE=..

# Containers normally have no desktop keyring. Environment-based secrets are
# used for this phase, and telemetry is disabled by default.
GOOSE_DISABLE_KEYRING=1
GOOSE_DISABLE_TELEMETRY=1
