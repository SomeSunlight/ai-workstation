# Copy this file to .env. The .env file is ignored by Git.
# Never commit real API keys.

# Shared OpenRouter credentials for Goose and Open WebUI.
OPENROUTER_API_KEY=

# Goose CLI runtime.
GOOSE_IMAGE=ghcr.io/aaif-goose/goose:v1.44.0
GOOSE_PROVIDER=openrouter
GOOSE_MODEL=
GOOSE_DISABLE_KEYRING=1
GOOSE_DISABLE_TELEMETRY=1

# Open WebUI service. It is exposed only on Windows/WSL localhost.
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.0
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
OPEN_WEBUI_MODEL_LIST_TIMEOUT=30
