#!/usr/bin/env bash
# NemoClaw's CLI owns Hermes/OpenShell lifecycle; AIW only provides an entry point.
set -Eeuo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
export PATH="$HOME/.local/bin:$PATH"
export NEMOCLAW_DISABLE_TELEMETRY=1
export NEMOCLAW_NO_EXPRESS=1
# This selection is essential. Without it, NemoClaw defaults to Docker and
# rejects native Docker on WSL even when Podman is installed.
export NEMOCLAW_GATEWAY_RUNTIME=podman

check_runtime() {
    if [[ -n "${DOCKER_HOST:-}" || -n "${DOCKER_CONTEXT:-}" || -n "${CONTAINER_HOST:-}" ]]; then
        printf '[BLOCKED] Untrusted redirected container socket environment.\n' >&2
        printf 'Use the dedicated Nemo WSL shortcut with the normal user context.\n' >&2
        return 1
    fi
    command -v podman >/dev/null 2>&1 || {
        printf '[BLOCKED] Podman is missing. Install through AIW Ansible first.\n' >&2
        return 1
    }
    if [[ ! -S "/run/user/$(id -u)/podman/podman.sock" ]]; then
        printf '[BLOCKED] Rootless current-user podman.socket is not active.\n' >&2
        printf 'Rerun the idempotent AIW installer; never use sudo podman.\n' >&2
        return 1
    fi
    if ! systemctl --user is-active --quiet podman.socket; then
        printf '[BLOCKED] Current-user Podman socket unit is not active.\n' >&2
        return 1
    fi
}

status() {
    printf '\nNemoClaw / Hermes (separate Ubuntu environment)\n'
    printf 'User: %s | WSL: %s\n' "$(id -un)" "${WSL_DISTRO_NAME:-native Linux}"
    printf 'NemoClaw runtime: rootless Podman (official Ubuntu packages; NOT Docker Desktop)\n'
    if command -v podman >/dev/null 2>&1; then
        podman --version || true
        printf 'Podman socket: %s\n' "$(if [[ -S "/run/user/$(id -u)/podman/podman.sock" ]]; then echo active; else echo missing; fi)"
    else
        printf 'Podman is not installed.\n'
    fi
    if command -v nemohermes >/dev/null 2>&1; then
        nemohermes --version || true
        printf 'NemoClaw manages sandbox status: use option 3 for its native CLI.\n'
    else
        printf 'NemoClaw Hermes CLI not yet installed. Choose option 2 after installation.\n'
    fi
    printf 'Guide: %s/docs/nemoclaw-operator.md\n' "$ROOT"
}
onboard() {
    command -v nemohermes >/dev/null 2>&1 || {
        printf 'First install the host with the NemoClaw installer.\n' >&2
        return 1
    }
    check_runtime
    printf 'Official NemoClaw Hermes onboarding. Select OpenRouter as first provider.\n'
    printf 'GPU passthrough: DISABLED (--no-gpu). OpenRouter needs no NVIDIA CUDA/CDI.\n'
    printf 'Enter credentials ONLY in the official wizard, never in AIW or Git.\n'
    printf 'Managed Windows Ollama and NVIDIA GPU passthrough are disabled.\n'
    # The CPU/remote-inference profile must skip NVIDIA CDI checks even when
    # Docker advertises generic CDISpecDirs without nvidia.com/gpu devices.
    # Preserve the choice on --resume; any future GPU enablement is an
    # explicitly reviewed separate profile, not an implicit toolkit install.
    nemohermes onboard --no-gpu "$@"
}
connect() {
    command -v nemohermes >/dev/null 2>&1 || { printf 'NemoClaw not installed.\n' >&2; return 1; }
    local title="$1"
    [[ "$title" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,62}$ ]] || {
        printf 'Choose a simple registered sandbox name (letters, digits, - or _).\n' >&2
        return 1
    }
    nemohermes "$title" connect
}
# Delegate to the official NemoClaw CLI, without parallel AIW state.
# Never rebuild, destroy or onboard as a side effect of a normal launch.
hermes_action() {
    local action="$1" sandbox="$2"
    [[ "$sandbox" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,62}$ ]] || {
        printf 'Choose an existing sandbox name (letters, digits, - or _).\n' >&2
        return 2
    }
    command -v nemohermes >/dev/null 2>&1 || {
        printf '[BLOCKED] nemohermes not installed; see docs/nemoclaw-recovery.md.\n' >&2
        return 1
    }
    case "$action" in
        launch)  nemohermes launch "$sandbox" ;;
        start)   nemohermes "$sandbox" start ;;
        stop)    nemohermes "$sandbox" stop ;;
        status)  nemohermes "$sandbox" status ;;
        recover) nemohermes "$sandbox" recover ;;
        *) printf 'Usage: aiw-nemo hermes [launch|start|stop|status|recover] NAME\n' >&2; return 2 ;;
    esac
}

hermes_menu() {
    local sandbox choice action
    read -r -p 'Registered Hermes sandbox name (e.g. testhermes01): ' sandbox || return
    [[ "$sandbox" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,62}$ ]] || {
        printf 'Invalid sandbox name; no action taken.\n' >&2
        return 2
    }
    printf ' 1) Launch interactive Hermes (upstream preflight)\n'
    printf ' 2) Start a stopped sandbox\n'
    printf ' 3) Stop this sandbox and keep its data\n'
    printf ' 4) Show sandbox status\n'
    printf ' 5) Recover gateway/port forwards (only when needed)\n'
    printf ' 0) Cancel\n'
    read -r -p 'Action: ' choice || return
    case "$choice" in
        1) action=launch ;;
        2) action=start ;;
        3) action=stop ;;
        4) action=status ;;
        5) action=recover ;;
        0) return ;;
        *) printf 'Unknown action; no change.\n' >&2; return 2 ;;
    esac
    if ! hermes_action "$action" "$sandbox"; then
        printf 'Hermes action failed. Inspect the output; see docs/nemoclaw-recovery.md.\n' >&2
        return 1
    fi
}

menu() {
    local choice title
    while true; do
        printf '\n🐧  NemoClaw + Hermes  🦞\n'
        printf ' 1) Show Ubuntu/Podman/NemoClaw status\n'
        printf ' 2) Set up Hermes / choose model provider (NemoClaw wizard)\n'
        printf ' 3) Open official NemoClaw management CLI\n'
        printf ' 4) Connect to my Hermes sandbox\n'
        printf ' 5) Verify Ubuntu 26, rootless Podman and NemoClaw\n'
        printf ' 6) Resume interrupted NemoClaw onboarding\n'
        printf ' 7) Hermes: launch / stop / start / recover (existing sandbox)\n'
        printf ' q) Exit to terminal\n'
        read -r -p 'Selection: ' choice || return
        case "$choice" in
            1) status ;;
            2) onboard ;;
            3) command -v nemohermes >/dev/null && nemohermes --help || printf 'Install NemoClaw first.\n' ;;
            4) read -r -p 'Hermes sandbox name: ' title; connect "$title" ;;
            5) "$ROOT/install.sh" verify --profile nemoclaw-podman ;;
            6) onboard --resume ;;
            7) hermes_menu ;;
            q|Q) return ;;
            *) printf 'Select a displayed option.\n' ;;
        esac
        printf '\n'
    done
}
case "${1:-menu}" in
    menu) menu ;;
    status) status ;;
    onboard) shift; onboard "$@" ;;
    connect) shift; [[ $# -eq 1 ]] || exit 2; connect "$1" ;;
    verify) "$ROOT/install.sh" verify --profile nemoclaw-podman ;;
    hermes) shift; [[ $# -eq 2 ]] || { printf 'Usage: aiw-nemo hermes [launch|start|stop|status|recover] NAME\n' >&2; exit 2; }; hermes_action "$1" "$2" ;;
    *) printf 'Usage: aiw-nemo [menu|status|onboard|connect NAME|verify|hermes ACTION NAME]\n' >&2; exit 2 ;;
esac
