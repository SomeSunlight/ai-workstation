#!/usr/bin/env bash
# NemoClaw's CLI owns Hermes/OpenShell lifecycle; AIW only provides an entry point.
set -Eeuo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
export PATH="$HOME/.local/bin:$PATH"
export NEMOCLAW_DISABLE_TELEMETRY=1
export NEMOCLAW_NO_EXPRESS=1

# NemoClaw 0.0.144's upstream WSL runtime admission fails CLOSED on a
# native WSL Docker daemon even with --no-gpu. Do not give the operator the
# same misleading "install NVIDIA Container Toolkit" instructions again.
# Refuse early and preserve the existing workspace until an approved supported
# runtime (Docker Desktop or qualified rootless Podman >=5) is configured.
unsupported_wsl_native_docker() {
    local wsl_detected=0
    if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then
        wsl_detected=1
    elif [[ -r /proc/sys/kernel/osrelease ]] && grep -qiE 'microsoft|wsl' /proc/sys/kernel/osrelease; then
        wsl_detected=1
    fi
    [[ "$wsl_detected" == 1 ]] || return 1
    [[ "${NEMOCLAW_GATEWAY_RUNTIME:-docker}" == podman ]] && return 1

    local engine_os
    engine_os="$(docker info --format '{{.OperatingSystem}}' 2>/dev/null || true)"
    # An inaccessible Docker Engine is also NOT proven to be Docker Desktop.
    [[ "$engine_os" != *"Docker Desktop"* ]]
}
check_onboarding_runtime() {
    if unsupported_wsl_native_docker; then
        cat >&2 <<'EOF'
[BLOCKED] NemoClaw does not qualify native Docker Engine inside WSL2.
          The previous '--no-gpu' correction was applied; NVIDIA Container
          Toolkit is NOT the solution for this platform-admission failure.
          Do not rerun installation or overwrite existing AIW-Nemo resources.
          Supported WSL provider options: Docker Desktop WSL backend, or a
          qualified rootless Podman >= 5.0 with explicit NemoClaw selection.
          Ubuntu 24.04's official Podman 4.9 is too old.
          Candidate OSS reference: Ubuntu 26.04 LTS + rootless Podman 5.7.
          Implementation/approval: https://github.com/SomeSunlight/ai-workstation/issues/77
EOF
        return 76
    fi
}

status() {
    printf '\nNemoClaw / Hermes (separate Ubuntu environment)\n'
    printf 'User: %s | WSL: %s\n' "$(id -un)" "${WSL_DISTRO_NAME:-native Linux}"
    if command -v docker >/dev/null 2>&1; then
        docker info --format 'Docker Engine: {{.ServerVersion}}' || true
    else
        printf 'Docker Engine is not installed.\n'
    fi
    if command -v nemohermes >/dev/null 2>&1; then
        nemohermes --version || true
        printf 'NemoClaw manages sandbox status: use option 3 for its native CLI.\n'
    else
        printf 'NemoClaw Hermes CLI not yet installed. Choose option 2 after installation.\n'
    fi
    if unsupported_wsl_native_docker; then
        printf '[!] Upstream runtime is blocked: native Docker in WSL2 is unqualified.\n'
        printf '[!] See issue #77; do not install NVIDIA Container Toolkit for OpenRouter.\n'
    fi
    printf 'Guide: %s/docs/nemoclaw-reference.md\n' "$ROOT"
}
onboard() {
    command -v nemohermes >/dev/null 2>&1 || {
        printf 'First install the host with the NemoClaw installer.\n' >&2
        return 1
    }
    check_onboarding_runtime || return $?
    printf 'Official NemoClaw Hermes onboarding. Select OpenRouter as first provider.\n'
    printf 'GPU passthrough: DISABLED (--no-gpu). OpenRouter needs no NVIDIA CUDA/CDI.\n'
    printf 'Enter credentials ONLY in the official wizard, never in AIW or Git.\n'
    printf 'NVIDIA Express (managed Windows Ollama) is disabled for this native Docker setup.\n'
    # The CPU/remote-inference profile must skip NVIDIA CDI checks even when
    # Docker advertises generic CDISpecDirs without nvidia.com/gpu devices.
    # Preserve the choice on --resume; any future GPU enablement is an
    # explicitly reviewed separate profile, not an implicit toolkit install.
    nemohermes onboard --no-gpu "$@"
}
connect() {
    command -v nemohermes >/dev/null 2>&1 || { printf 'NemoClaw not installed.\n' >&2; return 1; }
    local title="$1"
    [[ "$title" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,62}$ ]] || {
        printf 'Choose a simple registered sandbox name (letters, digits, - or _).\n' >&2
        return 1
    }
    nemohermes "$title" connect
}
menu() {
    local choice title
    while true; do
        printf '\n🐧  NemoClaw + Hermes  🦞\n'
        printf ' 1) Show local installation status\n'
        printf ' 2) Set up Hermes / choose model provider (NemoClaw wizard)\n'
        printf ' 3) Open official NemoClaw management CLI\n'
        printf ' 4) Connect to my Hermes sandbox\n'
        printf ' 5) Verify AIW-managed Linux host and Docker Engine\n'
        printf ' 6) Resume interrupted NemoClaw onboarding\n'
        printf ' q) Exit to terminal\n'
        read -r -p 'Selection: ' choice || return
        case "$choice" in
            1) status ;;
            2) onboard ;;
            3) command -v nemohermes >/dev/null && nemohermes --help || printf 'Install NemoClaw first.\n' ;;
            4) read -r -p 'Hermes sandbox name: ' title; connect "$title" ;;
            5) "$ROOT/install.sh" verify --profile nemoclaw ;;
            6) onboard --resume ;;
            q|Q) return ;;
            *) printf 'Select a displayed option.\n' ;;
        esac
        printf '\n'
    done
}
case "${1:-menu}" in
    menu) menu ;;
    status) status ;;
    onboard) shift; onboard "$@" ;;
    connect) shift; [[ $# -eq 1 ]] || exit 2; connect "$1" ;;
    verify) "$ROOT/install.sh" verify --profile nemoclaw ;;
    *) printf 'Usage: aiw-nemo [menu|status|onboard|connect NAME|verify]\n' >&2; exit 2 ;;
esac
