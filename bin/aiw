#!/usr/bin/env bash
# Stable front controller for AI Workstation.
set -Eeuo pipefail
IFS=$'\n\t'

readonly SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
readonly CORE="${ROOT}/bin/aiw-core"
readonly LOCAL_INFERENCE_MANAGER="${ROOT}/runtimes/local-inference/manage.sh"
readonly LOCAL_INFERENCE_SERVICE="${ROOT}/runtimes/local-inference/service.sh"
readonly LOCAL_INFERENCE_CONFIG="${AIW_LOCAL_INFERENCE_CONFIG:-${HOME}/.config/ai-workstation/local-inference.env}"

fail() {
    printf '[XX] %s\n' "$*" >&2
    exit 1
}

pause_menu() {
    printf '\nPress Enter to continue...'
    read -r _ || true
}

run_menu_action() {
    if ! "$@"; then
        printf '\n[XX] The command failed. Review the message above.\n' >&2
    fi
    pause_menu
}

require_core() {
    [[ -f "$CORE" ]] || fail "AI Workstation core command is missing: $CORE"
}

require_local_inference_manager() {
    [[ -f "$LOCAL_INFERENCE_MANAGER" ]] || fail "Local-inference manager is missing: $LOCAL_INFERENCE_MANAGER"
}

require_local_inference_service() {
    [[ -f "$LOCAL_INFERENCE_SERVICE" ]] || fail "Local-inference service manager is missing: $LOCAL_INFERENCE_SERVICE"
}

run_core() {
    require_core
    bash "$CORE" "$@"
}

local_inference_enabled() {
    [[ -f "$LOCAL_INFERENCE_CONFIG" ]] && grep -Fxq 'AIW_LOCAL_INFERENCE_ENABLED=true' "$LOCAL_INFERENCE_CONFIG"
}

local_inference() {
    require_local_inference_manager
    require_local_inference_service
    local subcommand="${1:-help}"
    case "$subcommand" in
        start|stop|restart|logs|autostart|runtime|service-run|render-service)
            bash "$LOCAL_INFERENCE_SERVICE" "$@"
            ;;
        status)
            bash "$LOCAL_INFERENCE_MANAGER" status
            printf '\n'
            bash "$LOCAL_INFERENCE_SERVICE" status
            ;;
        help|-h|--help)
            bash "$LOCAL_INFERENCE_MANAGER" help
            printf '\n'
            bash "$LOCAL_INFERENCE_SERVICE" help
            ;;
        *)
            bash "$LOCAL_INFERENCE_MANAGER" "$@"
            ;;
    esac
}

show_help() {
    run_core help
    cat <<'EOF'

Optional local inference:
  aiw local-inference setup sycl
  aiw local-inference runtime configure
  aiw local-inference start
  aiw local-inference stop
  aiw local-inference status
  aiw local-inference autostart enable
  aiw local-inference logs
  aiw local-inference help

`setup` prepares llama.cpp and Llama Dispatcher. `runtime configure` records the
machine-local model root plus the normal Dispatcher instance/ensemble. Afterwards
`start` needs no llama.cpp path, model path, environment variable or long Dispatcher
command. Autostart is opt-in and remains disabled until explicitly enabled.
EOF
}

show_status() {
    run_core status
    printf '\n'
    local_inference status
}

install_all() {
    run_core install
    if local_inference_enabled; then
        printf '\n[..] Local inference is enabled; reconciling its host runtime.\n'
        local_inference install
    else
        printf '\n[..] Local inference is not enabled; skipping optional host-local inference.\n'
    fi
}

verify_all() {
    run_core verify
    if local_inference_enabled; then
        printf '\n[..] Local inference is enabled; verifying it.\n'
        local_inference verify
    else
        printf '\n[..] Local inference is not enabled; optional verification skipped.\n'
    fi
}

local_inference_menu() {
    local choice name
    while true; do
        cat <<'EOF'

Local inference
===============
1) Show complete status
2) Configure normal Dispatcher start (model root / instance / ensemble)
3) Start Dispatcher
4) Stop Dispatcher
5) Restart Dispatcher
6) Follow Dispatcher logs
7) Enable autostart and start now
8) Disable autostart and stop
9) List llama.cpp builds
10) Select active llama.cpp build
11) Verify selected build and Dispatcher core
12) Setup Intel SYCL runtime (WSL / Ubuntu 24.04)
13) Setup generic Vulkan runtime
14) Show command help
b) Back
q) Exit
EOF
        read -r -p 'Select: ' choice || return
        case "$choice" in
            1) run_menu_action local_inference status ;;
            2) run_menu_action local_inference runtime configure ;;
            3) run_menu_action local_inference start ;;
            4) run_menu_action local_inference stop ;;
            5) run_menu_action local_inference restart ;;
            6) local_inference logs ;;
            7) run_menu_action local_inference autostart enable ;;
            8) run_menu_action local_inference autostart disable ;;
            9) run_menu_action local_inference llama list ;;
            10)
                read -r -p 'Build name: ' name || continue
                [[ -n "$name" ]] && run_menu_action local_inference llama select "$name"
                ;;
            11) run_menu_action local_inference verify ;;
            12) run_menu_action local_inference setup sycl ;;
            13) run_menu_action local_inference setup vulkan ;;
            14) run_menu_action local_inference help ;;
            b|B) return ;;
            q|Q) exit 0 ;;
            *) printf 'Unknown selection.\n' ;;
        esac
    done
}

main_menu() {
    local choice
    while true; do
        cat <<'EOF'

AI Workstation
==============
1) Standard tools (Goose / Open WebUI)
2) Local inference (llama.cpp / Llama Dispatcher)
3) Complete system status
4) Update installation
5) Command help
q) Exit
EOF
        read -r -p 'Select: ' choice || return
        case "$choice" in
            1) run_core ;;
            2) local_inference_menu ;;
            3) run_menu_action show_status ;;
            4) run_menu_action run_core update ;;
            5) run_menu_action show_help ;;
            q|Q) return ;;
            *) printf 'Unknown selection.\n' ;;
        esac
    done
}

command_name="${1:-menu}"
shift || true
case "$command_name" in
    menu)
        main_menu
        ;;
    local-inference|local_inference|local)
        local_inference "$@"
        ;;
    status)
        show_status
        ;;
    install)
        install_all
        ;;
    verify)
        verify_all
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        require_core
        exec bash "$CORE" "$command_name" "$@"
        ;;
esac
